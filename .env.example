# Set true only after replacing all draft content and completing the launch checklist.
NEXT_PUBLIC_SITE_LIVE=false
# A verified sender domain is required by Resend.
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_TO_EMAIL=Digibuzz.marketing.info@gmail.com
# Optional HTTPS CRM webhook. Configure either email or CRM delivery.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Production requires Turnstile. The site key is public; the secret stays on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Override for preview deployments; defaults to https://digibuzzmarketing.in
SITE_URL=http://127.0.0.1:3000
